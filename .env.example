# Stack-level env (sourced by infra/scripts/dev-up.sh).
# Copy to .env at repo root:  cp .env.example .env
# Laravel also has app/.env (see app/.env.example).

# --- Postgres / PostGIS (native local defaults) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=tad_analysis
DB_USERNAME=tad
DB_PASSWORD=tad
DATABASE_URL=postgresql://tad:tad@127.0.0.1:5432/tad_analysis

# --- Service ports ---
LARAVEL_PORT=8000
MARTIN_PORT=3000
PROXY_PORT=8080

# --- Map product knobs (also mirrored in app/.env) ---
MAP_HEIGHT_K=1
MAP_VPA_CAP=5000
MAP_PARCEL_MINZOOM=13
MAP_DEFAULT_METRIC=land
MAP_DEFAULT_MODE=color
MAP_COLOR_MIN=
MAP_COLOR_MAX=
MAP_TILES_URL=/tiles
MAP_OPENFREEMAP_STYLE=https://tiles.openfreemap.org/styles/liberty
MAP_LICENSE_FOOTER='Data from Tarrant Appraisal District (TAD). Informational only; not for legal, engineering, or surveying purposes.'

# Extrusion height (m) at a metric cap. 3000 rendered as walls; 300 reads as city blocks.
MAP_HEIGHT_CEILING_M=1000
